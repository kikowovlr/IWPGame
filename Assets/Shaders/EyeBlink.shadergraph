{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "dd62892502fb4643bcfa76a8041ad4df",
    "m_Title": "Subtract",
    "m_Content": "Normal Screen coords =\nBottom Left (0, 0)\nMiddle (0.5, 0.5)\nTop Right (1, 1)\n\nSubtracting 0.5 =\nBottom Left (-0.5, -0.5)\nMiddle (0, 0)\nTop Right (0.5, 0.5)\n\nHence, blinking would go to the center instead of bottom left\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2556.0,
        "y": -16.799999237060548,
        "width": 217.60009765625,
        "height": 208.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

